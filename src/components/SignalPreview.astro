---
interface Props {
  kind: "coverage" | "quality" | "sentiment" | "languages";
}
const { kind } = Astro.props;
---

<div class:list={["analysis-preview", `analysis-${kind}`]}>
  <div class="card-top">
    <span>
      {kind === "coverage"
        ? "Conversation coverage"
        : kind === "quality"
          ? "Quality over time"
          : kind === "sentiment"
            ? "The customer conversation"
            : "One standard. Every region."}
    </span>
    <span class="preview-badge">Illustrative preview</span>
  </div>
  {kind === "coverage" ? (
    <>
      <div class="coverage-metric">
        Every call.
        <br />
        <em>A clearer picture.</em>
      </div>
      <div class="call-grid" aria-hidden="true">
        {Array.from({ length: 100 }, (_, i) => (
          <span class:list={{ sampled: i < 5 }} />
        ))}
      </div>
      <div class="preview-legend">
        <span>● Manual sample: 1–5%</span>
        <span>○ The conversations beyond it</span>
      </div>
    </>
  ) : kind === "languages" ? (
    <>
      <div class="region-table">
        <div>
          <span>Language</span>
          <span>Quality review</span>
        </div>
        {["English", "Español", "Français", "Deutsch", "Português"].map(
          (language) => (
            <div>
              <span>{language}</span>
              <span>Same scorecard ↗</span>
            </div>
          ),
        )}
      </div>
      <p class="preview-footer">Local conversations. A shared view.</p>
    </>
  ) : (
    <>
      <div class="chart-heading">
        <span>
          {kind === "quality"
            ? "From review to better coaching."
            : "See the shift in sentiment."}
        </span>
        <span class="muted">Call insights ↗</span>
      </div>
      <svg
        viewBox="0 0 400 130"
        fill="none"
        role="img"
        aria-label={
          kind === "quality"
            ? "Illustrative quality trend"
            : "Illustrative sentiment timeline"
        }
      >
        <path
          d={
            kind === "quality"
              ? "M4 110C30 105 30 79 60 90S100 110 128 65 158 89 188 57 224 76 252 38 290 59 320 25 365 42 396 8"
              : "M4 30C38 30 44 12 76 34S108 20 142 42 169 29 200 67 230 40 265 80 310 55 340 98 370 85 396 113"
          }
          stroke="#111111"
          stroke-width="2.5"
          stroke-linecap="round"
        />
      </svg>
      <div class="chart-labels">
        <span>{kind === "quality" ? "Week 01" : "Call started"}</span>
        <span>{kind === "quality" ? "Week 04" : "Call ended"}</span>
      </div>
    </>
  )}
</div>
